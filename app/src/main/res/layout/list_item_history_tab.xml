<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <View
        android:id="@+id/view_history_tab_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/background_history_tab_item"
        app:layout_constraintBottom_toBottomOf="@+id/text_history_tab_date_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/button_delete_history_tab"
        app:layout_constraintTop_toTopOf="@id/text_history_tab_url" />

    <TextView
        android:id="@+id/text_history_tab_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textColor="?attr/colorOnSecondaryContainer"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="01.01.2026" />

    <ImageButton
        android:id="@+id/button_delete_history_tab"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_delete_history_tab"
        app:layout_constraintBottom_toBottomOf="@+id/text_history_tab_date_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/text_history_tab_url"
        app:tint="?attr/colorPrimary" />

    <TextView
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:id="@+id/text_history_tab_url"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:textSize="14sp"
        android:paddingTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/button_delete_history_tab"
        app:layout_constraintTop_toBottomOf="@+id/text_history_tab_date"
        tools:text="https://metanit.com/javakdjfkdjkjdkjdfkjfkdjdkjfkdjkdjfkdjfkd" />

    <TextView
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:id="@+id/text_history_tab_date_time"
        android:layout_width="0dp"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:paddingBottom="8dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/button_delete_history_tab"
        app:layout_constraintTop_toBottomOf="@+id/text_history_tab_url"
        tools:text="01.01.2026 13:30" />
</androidx.constraintlayout.widget.ConstraintLayout>