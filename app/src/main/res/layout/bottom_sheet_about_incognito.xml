<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_bottom_sheet"
    android:paddingHorizontal="16dp"
    android:paddingVertical="16dp">

    <ImageButton
        android:id="@+id/button_close_bottom_sheet"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_close_bottom_sheet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnPrimaryContainer" />

    <TextView
        android:id="@+id/text_caption_welcome_incognito_mode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/welcome_to_incognito_mode"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@id/button_close_bottom_sheet"
        app:layout_constraintEnd_toStartOf="@+id/button_close_bottom_sheet"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/button_close_bottom_sheet" />

    <TextView
        android:id="@+id/text_caption_about_incognito_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingTop="16dp"
        android:text="@string/about_incognito_mode"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@+id/text_caption_welcome_incognito_mode" />

</androidx.constraintlayout.widget.ConstraintLayout>